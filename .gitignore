/target

# Machine-local: pins the linker to work around a shadowed `cc` on one
# machine. Hardcoding a gcc path would break other contributors.
/.cargo/config.toml

# Personal Claude Code settings (permission mode, model, local hooks).
/.claude/

# Vendored pdfium, downloaded per build by the release workflow from the tag
# pinned in .github/workflows/release.yml. A 7 MB prebuilt binary does not
# belong in git; packaging/README.md documents where it comes from.
/packaging/vendor/
