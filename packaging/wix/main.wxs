<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX source for the sekio Windows installer.

  Derived from cargo-wix's own template (`cargo wix print WXS`, cargo-wix
  0.3.9, Apache-2.0, Copyright (C) 2017 Christopher R. Field) and then edited
  to ship all three frontends, keep the PATH entry, and add an optional Start
  Menu shortcut. It is checked in rather than generated at build time so the
  UpgradeCode and the Path component GUID stay stable across releases - those
  two GUIDs are what make an upgrade an upgrade instead of a second parallel
  installation, and `cargo wix init`/`print` mints fresh ones on every run.

  NEVER change UpgradeCode or the Path component Guid.

  This targets WiX Toolset v3 (candle.exe / light.exe), which is what
  cargo-wix 0.3.x drives. It is not WiX v4/v5 syntax.

  Built by .github/workflows/release.yml on windows-latest, run from the
  workspace root. The exact commands live in packaging/README.md rather than
  here, because an XML comment may not contain a double hyphen and every
  interesting cargo flag has one.

  Relative Source paths below are resolved by light's bind paths. cargo-wix
  passes the package manifest directory (crates/sekio-cli) as the base path, so
  the workflow adds the workspace root as a second bind path; that is what
  makes 'packaging\wix\License.rtf' resolve.

  cargo-wix supplies these preprocessor variables:

    CargoTargetBinDir = absolute path to the directory holding the built exes
    CargoTargetDir    = the `target` directory
    CargoProfile      = build profile ("release")
    Version           = the package version, as x.y.z
    TargetTriple / TargetEnv / TargetVendor / Platform

  and invokes candle with `-ext WixUtilExtension` and light with
  `-ext WixUIExtension -ext WixUtilExtension`, so WixUI_FeatureTree resolves.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='sekio'
        UpgradeCode='5A0E7C04-DE32-482F-8EAD-23C25D54E749'
        Manufacturer='sekio contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Fast quick-view for any filetype (CLI, TUI, and GUI previewer)'
            Manufacturer='sekio contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='sekio Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='sekio'>

                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='packaging\wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <!--
                        pdfium's own license (BSD-3-Clause, plus the notices of
                        the libraries it embeds). Shipping the DLL means
                        shipping this file, so it sits beside sekio's own
                        license rather than in the bin directory.
                    -->
                    <Component Id='PdfiumLicense' Guid='*'>
                        <File Id='PdfiumLicenseFile'
                            Name='LICENSE-pdfium.txt'
                            DiskId='1'
                            Source='packaging\vendor\pdfium\LICENSE-pdfium.txt'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <!--
                          Adds the bin directory to the system PATH. Guid is
                          fixed, not '*': an Environment element is not a file,
                          so WiX cannot derive a stable auto-GUID for it, and a
                          changing GUID would orphan the old PATH entry on
                          upgrade instead of replacing it.
                        -->
                        <Component Id='Path' Guid='6B67EB40-E2BF-45B1-A28C-56243B703C95' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>

                        <!--
                          Starts the preview daemon at login, by writing one
                          value named 'sekio' under the Run key.

                          Same shape as the Path component just above and for
                          the same reason: a registry value is not a file, so
                          WiX cannot derive a stable auto-GUID for the
                          component and the Guid is fixed rather than '*'. A
                          changing GUID would orphan the old Run value on
                          upgrade instead of replacing it.

                          Root='HKMU' is load-bearing. It resolves to HKLM in
                          this package, which is InstallScope='perMachine'
                          (ALLUSERS=1), so the component holds nothing but
                          per-machine data in a per-machine package, and
                          light's ICE validation has nothing to object to.
                          Writing HKCU here instead would put per-user data in
                          a component that installs under ProgramFiles64Folder,
                          which is the mix ICE57 rejects, and would also make
                          the daemon start for the one account that happened to
                          run the installer rather than for everyone. The Start
                          Menu shortcut below has no choice about this - a
                          shortcut in the user profile IS per-user data, hence
                          its HKCU KeyPath - but an autostart entry does.

                          HKLM Run also matches what the Linux packages do:
                          they enable the systemd user unit globally, for every
                          user on the machine, not just the installing one.

                          Keying the entry by NAME is what makes upgrades safe.
                          MSI writes the same value name every time, so a
                          reinstall or a major upgrade overwrites one entry
                          rather than accumulating a second, and uninstall
                          deletes it. A Startup folder shortcut has no such
                          guarantee and would need its own Directory and a
                          RemoveFile besides.

                          The off switch for a user who does not want it is
                          Task Manager, Startup apps, which lists Run entries
                          and remembers the choice in StartupApproved across
                          upgrades. README.md documents that and the registry
                          equivalent.

                          [Bin] expands to the install directory with its
                          trailing backslash, and the quotes around it are
                          required: the default path contains a space.
                        -->
                        <Component Id='AutostartRegistry' Guid='E8268E9C-9DF5-4AE8-A927-868153A88170'>
                            <RegistryValue
                                Root='HKMU'
                                Key='Software\Microsoft\Windows\CurrentVersion\Run'
                                Name='sekio'
                                Type='string'
                                Value='"[Bin]sekio-gui.exe" --daemon'
                                KeyPath='yes'/>
                        </Component>

                        <!--
                          One component per binary, each with the exe as its
                          KeyPath, which is what lets Guid='*' derive a stable
                          GUID from the install path.
                        -->
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='sekio.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\sekio.exe'
                                KeyPath='yes'/>
                        </Component>

                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='sekio-tui.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\sekio-tui.exe'
                                KeyPath='yes'/>
                        </Component>

                        <Component Id='binary2' Guid='*'>
                            <File
                                Id='exe2'
                                Name='sekio-gui.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\sekio-gui.exe'
                                KeyPath='yes'/>
                        </Component>

                        <!--
                          pdfium, the PDF page renderer. It must sit in this
                          directory, beside the exes: sekio looks for it next
                          to the running program first, which is what lets a
                          scanned PDF - all images, no text layer - preview as
                          a page image with no configuration.

                          Guid='*' is fine here for the same reason as the
                          exes above: the File is the KeyPath, so WiX derives a
                          stable GUID from the install path. Only the
                          UpgradeCode and the Path component GUID are fixed.

                          Source is resolved through light's second bind path
                          (the workspace root), like License.rtf. The release
                          workflow downloads it there from a pinned upstream
                          tag; see packaging/README.md.
                        -->
                        <Component Id='pdfium' Guid='*'>
                            <File
                                Id='pdfiumdll'
                                Name='pdfium.dll'
                                DiskId='1'
                                Source='packaging\vendor\pdfium\pdfium.dll'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='sekio'/>
            </Directory>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <!--
              Fixed Guid for the same reason as the Path component: the KeyPath
              is a registry value, not a file, so Guid='*' is not available.

              The shortcut points at sekio-gui, the graphical previewer, which
              is what someone clicking a Start Menu entry expects. It used to
              point at sekio-tui because sekio-gui required a path argument and
              a no-argument launch failed immediately; it now opens to a file
              browser with an Open button, so the natural target is correct.
              sekio-tui is reached from a terminal, and sekio-gui is also
              wired into Explorer's "Open with" - see docs/desktop.md.

              The KeyPath MUST be HKCU, and this is not a preference. A Start
              Menu shortcut is per-user data, so light's ICE validation rejects
              an HKLM KeyPath here three times over: ICE38 (component installs
              to user profile, KeyPath must be under HKCU), ICE43 (non-
              advertised shortcut, KeyPath should be under HKCU) and ICE57
              (per-user and per-machine data mixed in one component). HKCU
              makes the whole component per-user and consistent, which is the
              shortcut pattern the WiX documentation prescribes.

              Note ICE runs only inside `light` on Windows, so this cannot be
              caught by schema validation on a Linux box - only by the msi CI
              job, which is dispatchable without cutting a release.
            -->
            <Component Id='StartMenuShortcut' Guid='49F4BE84-EA94-4F9D-B5E3-31C8304F1CFD'>
                <Shortcut Id='SekioGuiShortcut'
                    Name='sekio'
                    Description='Quick-view any file'
                    Target='[Bin]sekio-gui.exe'
                    WorkingDirectory='PersonalFolder'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder'
                    Directory='ApplicationProgramsFolder'
                    On='uninstall'/>
                <RegistryValue Root='HKCU'
                    Key='Software\sekio'
                    Name='StartMenuShortcut'
                    Type='integer'
                    Value='1'
                    KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs sekio, sekio-tui and sekio-gui, the pdfium PDF renderer, and the licenses.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='License'/>
            <ComponentRef Id='PdfiumLicense'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='binary2'/>
            <!--
              Not a separate, unstickable feature: without pdfium a scanned PDF
              has no preview at all, so it is part of the application.
            -->
            <ComponentRef Id='pdfium'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executables to the PATH system environment variable. This allows sekio, sekio-tui and sekio-gui to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>

            <!--
              Enabled by default, and a sub-feature so the WixUI_FeatureTree
              dialog offers it as a checkbox to clear at install time. Nested
              inside Binaries because the Run value points at sekio-gui.exe,
              which that feature installs.
            -->
            <Feature
                Id='Autostart'
                Title='Start the preview daemon at login'
                Description='Keep sekio-gui resident in the background so a preview opens instantly instead of starting a process. Writes one Run entry; it can be turned off later from Task Manager, under Startup apps.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='AutostartRegistry'/>
            </Feature>

            <!--
              A sub-feature, so the WixUI_FeatureTree dialog offers it as a
              checkbox the user can clear. Nested inside Binaries so the
              shortcut's target file is guaranteed installed whenever the
              shortcut is (a non-advertised Shortcut whose target lives in a
              feature that might be absent is an ICE error).
            -->
            <Feature
                Id='StartMenuShortcuts'
                Title='Start Menu Shortcut'
                Description='Add a Start Menu entry that opens the sekio terminal file browser.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='StartMenuShortcut'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!--
          The icon Add/Remove Programs (Settings > Apps > Installed apps) shows
          beside the entry. Without ARPPRODUCTICON Windows draws a generic
          package box there, whatever icons the installed binaries carry.

          The Id must keep the .ico extension: WiX writes it into the MSI Icon
          table verbatim, and the installer picks the icon format from that
          name rather than from the file's contents.

          Source is resolved through light's second bind path, the workspace
          root, exactly like License.rtf above. This is the same multi-size
          .ico that build.rs compiles into sekio-gui.exe as a resource, so the
          installer entry and the executable cannot drift apart.

          Nothing here touches the Start Menu shortcut: it points at
          sekio-gui.exe, and a non-advertised shortcut takes the icon from its
          target's own resource. Giving that component an Icon attribute would
          mean editing it, and its KeyPath is load-bearing (see the
          StartMenuShortcut component above).
        -->
        <Icon Id='sekio.ico' SourceFile='assets\sekio.ico'/>
        <Property Id='ARPPRODUCTICON' Value='sekio.ico'/>

        <Property Id='ARPHELPLINK' Value='https://github.com/hairbui76/sekio'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/hairbui76/sekio'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='packaging\wix\License.rtf'/>

    </Product>

</Wix>
